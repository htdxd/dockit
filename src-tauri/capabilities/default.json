{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for Skill Toolbox",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**", "app": null }]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
