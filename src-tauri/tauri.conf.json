{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocKit Resume",
  "version": "0.4.2",
  "identifier": "io.skilltoolbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocKit Resume · AI 简历制作",
        "dragDropEnabled": true,
        "width": 1080,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] }
    }
  }
}
